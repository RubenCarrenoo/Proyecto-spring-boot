    {
      "name": "Escenario 01 - Reservar sala libre con 2 servicios -> 201",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
          "// Fecha aleatoria lejana para que la colección se pueda repetir",
          "const d = new Date(); d.setDate(d.getDate() + 30 + Math.floor(Math.random() * 300));",
          "pm.collectionVariables.set('fecha', d.toISOString().substring(0, 10));"
        ]}},
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "const b = pm.response.json();",
          "pm.test('Estado PENDING', () => pm.expect(b.estado).to.eql('PENDING'));",
          "pm.test('2 servicios', () => pm.expect(b.servicios.length).to.eql(2));",
          "pm.test('costoServicios = 2x8000 + 1x12000', () => pm.expect(b.costoServicios).to.eql(28000));",
          "pm.test('costoTotal calculado', () => pm.expect(b.costoTotal).to.eql(b.costoSala + b.costoServicios));",
          "pm.collectionVariables.set('reservaS1', b.id);"
        ]}}
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"salaId\": 1,\n  \"miembroId\": 3,\n  \"inicio\": \"{{fecha}}T09:00:00\",\n  \"fin\": \"{{fecha}}T10:00:00\",\n  \"asistentes\": 4,\n  \"servicios\": [\n    { \"servicioId\": 1, \"cantidad\": 2 },\n    { \"servicioId\": 3, \"cantidad\": 1 }\n  ]\n}" },
        "url": "{{baseUrl}}/api/reservas"
      }
    },
    {
      "name": "Escenario 02 - Reserva que se cruza -> 409 RN-01",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
        "pm.test('codigo RN-01', () => pm.expect(pm.response.json().codigo).to.eql('RN-01'));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }, { "key": "Content-Type", "value": "application/json" }],
